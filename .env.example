# ---- Neo4j (ganti ke KG milik teman cukup dengan mengubah 3 baris ini) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---- Skema graph (samakan dengan KG yang dituju) ----
KG_ENTITY_LABEL=__Entity__
KG_ENTITY_NAME_PROP=name
KG_ENTITY_ID_PROP=id
KG_STRUCTURAL_RELS=MENTIONS,NEXT,PART_OF

# ---- LLM (groq | ollama | mock) ----
KG_LLM_PROVIDER=groq
KG_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=isi_api_key_mu

# Untuk provider ollama, KG_LLM_MODEL WAJIB diisi model yang benar-benar ada di
# server Ollama-mu (tidak ada default) — kalau tidak, kg-agent langsung error
# sambil menyebutkan daftar model yang tersedia di sana. Contoh yang dipakai
# saat pengembangan Phase 5:
#   KG_LLM_PROVIDER=ollama
#   KG_LLM_MODEL=qwen3-vl:4b

# ---- Faithfulness judge (opsional) ----
# Juri faithfulness (Phase 4) boleh memakai model TERPISAH dari model utama.
# Kosong = pakai model utama (perilaku lama). Berguna saat model utama adalah
# model "thinking" (mis. qwen3-vl:4b) yang tidak pernah menghasilkan verdict
# JSON ringkas: pisahkan juri ke model instruct biasa. KG_JUDGE_OLLAMA_URL
# default mengikuti OLLAMA_URL, jadi juri bisa di Ollama lokal walau model
# utama di endpoint remote.
KG_JUDGE_PROVIDER=
KG_JUDGE_MODEL=
# Contoh (juri instruct lokal + model utama thinking di remote):
#   KG_JUDGE_PROVIDER=ollama
#   KG_JUDGE_MODEL=hermes3:3b     # 3b cepat di CPU; 8b lebih akurat kalau ada GPU
#   KG_JUDGE_OLLAMA_URL=http://localhost:11434

# ---- Retrieval ----
KG_VECTOR_INDEX=vector
KG_EMBED_MODEL=mxbai-embed-large
OLLAMA_URL=http://localhost:11434
KG_RETRIEVAL_TOP_K=5

# ---- Orchestrator Phase 5 (native | off) ----
# "native" = LLM yang memilih tool lewat parameter `tools` milik Ollama.
# Default "off": semua jalur lama berjalan persis seperti sebelumnya.
# Gate verifikasi (trust/temporal/faithfulness) tetap berlaku — LLM hanya
# memilih tool mana yang dipanggil, bukan menggantikan verifikasi.
KG_ORCHESTRATOR=off
# Batas keras jumlah tool call yang dieksekusi per request.
KG_ORCHESTRATOR_MAX_CALLS=4
# Contoh konfigurasi yang sudah diuji (endpoint remote + model tool-calling):
#   OLLAMA_URL=http://100.118.203.111:11434
#   KG_LLM_PROVIDER=ollama
#   KG_LLM_MODEL=qwen3-vl:4b
#   KG_ORCHESTRATOR=native
# Model apa pun bisa dipakai asal `capabilities` di POST /api/show memuat
# "tools" — cek dengan:
#   curl $OLLAMA_URL/api/show -d '{"model":"<nama-model>"}'

# ---- Verifier gates ----
KG_MIN_TRUST_SCORE=0.4
KG_MIN_FAITHFULNESS=0.7
KG_MAX_RETRIES=1
