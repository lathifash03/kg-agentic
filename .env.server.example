# Template .env untuk API yang jalan DI server dev (citi-cygnus, 100.118.203.111).
# Karena API co-located dengan Ollama di server ini, semua URL Ollama = localhost.
# Neo4j dijangkau lewat Tailscale.

# ---- Neo4j ----
# Sementara: KG Nabhyla (read untuk /query). Untuk ingest_meeting (MENULIS),
# tentukan dulu KG meeting-nya (keputusan b) sebelum dipakai menulis.
NEO4J_URI=bolt://100.110.179.78:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---- Profil skema (Chunk/MENTIONS + vector — pemenang eval) ----
KG_ENTITY_LABEL=Topic
KG_ENTITY_NAME_PROP=name
KG_ENTITY_ID_PROP=id
KG_STRUCTURAL_RELS=HAS_TYPE,HAS_SUBTOPIC,HAS_DESCRIPTION,HAS_SOURCE,ROLE_IN_PAPER,RELATES_TO,WRITES_ABOUT
KG_CHUNK_LABEL=Chunk
KG_CHUNK_TEXT_PROP=text
KG_CHUNK_TO_ENTITY_PATTERN=(c:{chunk_label})-[:MENTIONS]->(e:{entity_label})

# ---- Retrieval / embedding (Ollama LOKAL di server) ----
KG_VECTOR_INDEX=vector
KG_EMBED_MODEL=mxbai-embed-large
KG_EMBED_URL=http://localhost:11434
KG_VECTOR_MIN_SCORE=0.78
KG_RETRIEVAL_TOP_K=5

# ---- LLM (Ollama LOKAL di server) ----
KG_LLM_PROVIDER=ollama
KG_LLM_MODEL=hermes3:3b
OLLAMA_URL=http://localhost:11434

# ---- Juri faithfulness (Ollama LOKAL di server) ----
KG_JUDGE_PROVIDER=ollama
KG_JUDGE_MODEL=hermes3:3b
KG_JUDGE_OLLAMA_URL=http://localhost:11434

# ---- Orchestrator ----
KG_ORCHESTRATOR=off
KG_ORCHESTRATOR_MAX_CALLS=4

# ---- Gate verifikasi ----
KG_MIN_TRUST_SCORE=0.4
KG_MIN_FAITHFULNESS=0.7
KG_MAX_RETRIES=1
