# ---- Neo4j (ganti ke KG milik teman cukup dengan mengubah 3 baris ini) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---- Skema graph (samakan dengan KG yang dituju) ----
KG_ENTITY_LABEL=__Entity__
KG_ENTITY_NAME_PROP=name
KG_ENTITY_ID_PROP=id
KG_STRUCTURAL_RELS=MENTIONS,NEXT,PART_OF

# ---- LLM (groq | ollama | mock) ----
KG_LLM_PROVIDER=groq
KG_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=isi_api_key_mu

# ---- Retrieval ----
KG_VECTOR_INDEX=vector
KG_EMBED_MODEL=mxbai-embed-large
OLLAMA_URL=http://localhost:11434
KG_RETRIEVAL_TOP_K=5

# ---- Verifier gates ----
KG_MIN_TRUST_SCORE=0.4
KG_MIN_FAITHFULNESS=0.7
KG_MAX_RETRIES=1
