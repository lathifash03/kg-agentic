# Template .env untuk DEPLOY API kg-agent (docker-compose.prod.yml).
# Salin ke .env, isi endpoint sesuai topologi deploy-mu.
#
# CATATAN JARINGAN (penting): dari dalam container, `localhost` = container,
# BUKAN host. Untuk service di host laptop pakai `host.docker.internal`; untuk
# service Tailscale/remote pakai IP-nya langsung.

# ---- Neo4j: KG penelitian (SUMBER KEBENARAN) ----
# Verifikasi setelah deploy - hitung PAPER-nya, bukan total Document. Korpus
# ini juga memuat transkrip meeting dan beberapa Document fixture tanpa chunk,
# jadi `count(d)` total bukan angka yang bisa dipakai:
#   MATCH (d:Document) WHERE d.doc_type='paper' RETURN count(d)   -> harus 8
# Nilai sebelumnya di berkas ini (bolt://100.110.179.78:7687, user neo4j)
# menunjuk instance LAIN di mesin berbeda: disemai dari keluaran chunker yang
# sama (cacat P1 identik) lalu ditumpuki belasan transkrip meeting, dan terus
# bertambah. Jangan dipakai - jawaban akan bersumber dari korpus yang salah
# tanpa gejala apa pun.
NEO4J_URI=bolt://100.118.203.111:7690
NEO4J_USERNAME=sinyo
# Kredensial JANGAN ditulis di repo (berkas ini publik di GitHub).
# Ambil dari catatan ops tim / password manager, lalu isi di `.env` lokal.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Profil skema (hasil evaluasi: Chunk/MENTIONS + vector menang telak) ----
KG_ENTITY_LABEL=Topic
KG_ENTITY_NAME_PROP=name
KG_ENTITY_ID_PROP=id
KG_STRUCTURAL_RELS=HAS_TYPE,HAS_SUBTOPIC,HAS_DESCRIPTION,HAS_SOURCE,ROLE_IN_PAPER,RELATES_TO,WRITES_ABOUT
KG_CHUNK_LABEL=Chunk
KG_CHUNK_TEXT_PROP=text
KG_CHUNK_TO_ENTITY_PATTERN=(c:{chunk_label})-[:MENTIONS]->(e:{entity_label})
# Tanpa ini `documents_used` selalu kosong: jawaban tetap keluar tapi tidak
# bisa dilacak ke paper mana pun, dan metrik provenance jadi nol.
KG_CHUNK_SOURCE_PROP=filename

# ---- Retrieval / embedding ----
KG_VECTOR_INDEX=vector
# WAJIB sama dengan model yang meng-embed chunk. Sumber kebenarannya properti
# `embeddings_model` pada :Chunk, BUKAN dimensi index - dua model 1024-dim yang
# berbeda tidak akan memunculkan error, retrieval cuma balik kosong diam-diam.
#   MATCH (c:Chunk) RETURN DISTINCT c.embeddings_model, count(*)
KG_EMBED_MODEL=qwen3-embedding:0.6b
# PILIH SATU TOPOLOGI, dan pakai nilai yang SAMA di tiga variabel Ollama di
# berkas ini (KG_EMBED_URL, OLLAMA_URL, KG_JUDGE_OLLAMA_URL):
#
#   (A) Ollama co-located di host yang sama + `network_mode: host` di compose
#       -> http://localhost:11434
#       Di Docker LINUX ini satu-satunya cara memakai Ollama lokal: secara
#       default Ollama hanya listen di 127.0.0.1 dan MENOLAK koneksi dari
#       container apa pun alamat yang dipakai. Bridge + host.docker.internal
#       hanya bekerja di Docker Desktop (macOS).
#
#   (B) Ollama di mesin lain lewat Tailscale -> http://<ip-tailscale>:11434
#       IP tailnet adalah IP biasa yang dirutekan host, jadi bridge mode jalan
#       apa adanya - tidak perlu mengubah compose sama sekali.
#
# Salah pilih TIDAK memunculkan error: /health tetap hijau (`neo4j_connected`
# hanya menguji Neo4j) sementara setiap jawaban balik kosong. Buktikan dengan
# scripts/smoke_endpoint.py, jangan berhenti di /health.
KG_EMBED_URL=http://100.118.203.111:11434
KG_VECTOR_MIN_SCORE=0.78                 # ambang similarity (buang out-of-scope)
KG_RETRIEVAL_TOP_K=5

# ---- LLM (answer-gen + tool-calling) ----
KG_LLM_PROVIDER=ollama
KG_LLM_MODEL=hermes3:3b
OLLAMA_URL=http://100.118.203.111:11434
# Per PANGGILAN LLM, bukan per request. Plafon yang dilihat klien =
# KG_LLM_TIMEOUT * 2 * (KG_MAX_RETRIES + 1); jaga tetap di bawah timeout klien.
#   60 x 2 x 2 = 240 dtk  <  timeout klien 300 dtk   OK
KG_LLM_TIMEOUT=60

# ---- Juri faithfulness (model instruct non-thinking) ----
KG_JUDGE_PROVIDER=ollama
KG_JUDGE_MODEL=hermes3:3b
KG_JUDGE_OLLAMA_URL=http://100.118.203.111:11434   # samakan dengan OLLAMA_URL di atas

# ---- Orchestrator ----
# "native" = LLM memilih tool (termasuk ingest_meeting yang MENULIS). Untuk
# meeting Rio yang perlu ingest, ini boleh "native" ASAL izin menulis ke KG
# sudah jelas. Default "off" = hanya /query & /tools/{name} eksplisit.
# Read-only WAJIB true selama menunjuk KG bersama. Menolak POST /setup dan tool
# `ingest_meeting` dengan 403, termasuk lewat POST /query {"agentic": true}.
# KG_ORCHESTRATOR=off saja tidak cukup untuk itu.
KG_READ_ONLY=true

KG_ORCHESTRATOR=off
KG_ORCHESTRATOR_MAX_CALLS=4

# ---- Gate verifikasi ----
KG_MIN_TRUST_SCORE=0.4
KG_MIN_FAITHFULNESS=0.7
KG_MAX_RETRIES=1
