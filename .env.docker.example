# Template .env untuk DEPLOY API kg-agent (docker-compose.prod.yml).
# Salin ke .env, isi endpoint sesuai topologi deploy-mu.
#
# CATATAN JARINGAN (penting): dari dalam container, `localhost` = container,
# BUKAN host. Untuk service di host laptop pakai `host.docker.internal`; untuk
# service Tailscale/remote pakai IP-nya langsung.

# ---- Neo4j: KG Nabhyla ----
NEO4J_URI=bolt://100.110.179.78:7687     # ganti kalau Neo4j pindah/rebuild
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---- Profil skema (hasil evaluasi: Chunk/MENTIONS + vector menang telak) ----
KG_ENTITY_LABEL=Topic
KG_ENTITY_NAME_PROP=name
KG_ENTITY_ID_PROP=id
KG_STRUCTURAL_RELS=HAS_TYPE,HAS_SUBTOPIC,HAS_DESCRIPTION,HAS_SOURCE,ROLE_IN_PAPER,RELATES_TO,WRITES_ABOUT
KG_CHUNK_LABEL=Chunk
KG_CHUNK_TEXT_PROP=text
KG_CHUNK_TO_ENTITY_PATTERN=(c:{chunk_label})-[:MENTIONS]->(e:{entity_label})

# ---- Retrieval / embedding ----
KG_VECTOR_INDEX=vector
KG_EMBED_MODEL=mxbai-embed-large        # WAJIB sama dengan model yang meng-embed chunk
KG_EMBED_URL=http://100.118.203.111:11434   # host Ollama yang menjalankan mxbai
KG_VECTOR_MIN_SCORE=0.78                 # ambang similarity (buang out-of-scope)
KG_RETRIEVAL_TOP_K=5

# ---- LLM (answer-gen + tool-calling) ----
KG_LLM_PROVIDER=ollama
KG_LLM_MODEL=hermes3:3b
OLLAMA_URL=http://100.118.203.111:11434

# ---- Juri faithfulness (model instruct non-thinking) ----
KG_JUDGE_PROVIDER=ollama
KG_JUDGE_MODEL=hermes3:3b
KG_JUDGE_OLLAMA_URL=http://100.118.203.111:11434   # pull hermes3:3b di host ini

# ---- Orchestrator ----
# "native" = LLM memilih tool (termasuk ingest_meeting yang MENULIS). Untuk
# meeting Rio yang perlu ingest, ini boleh "native" ASAL izin menulis ke KG
# sudah jelas. Default "off" = hanya /query & /tools/{name} eksplisit.
KG_ORCHESTRATOR=off
KG_ORCHESTRATOR_MAX_CALLS=4

# ---- Gate verifikasi ----
KG_MIN_TRUST_SCORE=0.4
KG_MIN_FAITHFULNESS=0.7
KG_MAX_RETRIES=1
